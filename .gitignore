appsettings.Development.json
appsettings.local.json
.env
.env.*
!.env.example

# =========================================================================
# Containers & Docker (If using containerized resources locally)
# =========================================================================
.dockerignore
# If your AppHost spins up persistent local volumes
.db-data/
.postgres-data/

